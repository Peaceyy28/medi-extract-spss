# MediExtract SPSS Backend Configuration
MEDIEXTRACT_APP_ENV=development
MEDIEXTRACT_DATA_DIR=./data
MEDIEXTRACT_WATCH_FOLDER=C:\EncounterForms\ScanQueue
MEDIEXTRACT_CORS_ORIGINS=["*"]

# Vision HTR Provider Chain (local offline Ollama primary; add HF_TOKEN / GROQ_API_KEY for hosted demo mode)
MEDIEXTRACT_VISION_PROVIDER_CHAIN=ollama,huggingface,groq
MEDIEXTRACT_OLLAMA_BASE_URL=http://localhost:11434/v1
MEDIEXTRACT_OLLAMA_VISION_MODEL=qwen2.5vl:3b
MEDIEXTRACT_HF_BASE_URL=https://router.huggingface.co/v1
MEDIEXTRACT_HF_TOKEN=
MEDIEXTRACT_HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
MEDIEXTRACT_GROQ_BASE_URL=https://api.groq.com/openai/v1
MEDIEXTRACT_GROQ_API_KEY=
MEDIEXTRACT_GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Semantic Auto-Coder Embeddings ("fastembed" | "hf_api" | "stub")
MEDIEXTRACT_EMBEDDING_BACKEND=fastembed
MEDIEXTRACT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEDIEXTRACT_CONFIDENCE_THRESHOLD=0.90
